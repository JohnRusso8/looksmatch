rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // The scorePhoto Cloud Function reads these directly (Admin SDK,
    // bypasses these rules) — the LooksMatch score is always computed from
    // one of these, never a separate throwaway upload.
    match /profile_photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
